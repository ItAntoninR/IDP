# =============================================================================
# Auth service — environment variables
# Every variable is validated at startup (server/lib/env.ts). Never commit
# secrets: copy this file to `.env` and fill it in.
# =============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info

# Public URL of the service (without /api/auth). The OIDC issuer is `${AUTH_BASE_URL}/api/auth`.
# With https, cookies are `Secure` (__Secure- prefix).
AUTH_BASE_URL=http://localhost:3000

# Better Auth encryption/signing secret (>= 32 characters).
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgres://auth:auth@localhost:5435/auth

# --- Client apps -------------------------------------------------------------
# App origins (CORS + trusted origins).
DATAHUB_URL=http://localhost:4001
APP_URL=http://localhost:4002
# RFC 8707 resource identifiers: they become the access token `aud`.
DATAHUB_RESOURCE=https://datahub.mondomaine.fr
APP_RESOURCE=https://app.mondomaine.fr
# Allowed OAuth redirect URIs (comma-separated).
DATAHUB_REDIRECT_URIS=http://localhost:4001/auth/callback
APP_REDIRECT_URIS=http://localhost:4002/auth/callback

# Namespace of the custom token claims (e.g. https://mondomaine.fr/access).
CLAIMS_NAMESPACE=https://mondomaine.fr
# Access token lifetime, in seconds.
ACCESS_TOKEN_TTL_SECONDS=600

# --- Email (Mailpit in dev: http://localhost:8025) ----------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Mon Domaine <no-reply@mondomaine.fr>"

# --- Authentik (staff sign-in) ------------------------------------------------
# Issuer of the Authentik OIDC provider. The values below match the local Authentik started by docker compose.
AUTHENTIK_ISSUER=http://localhost:9000/application/o/auth-service
AUTHENTIK_CLIENT_ID=auth-service-local
AUTHENTIK_CLIENT_SECRET=auth-service-local-secret
# Refuse staff sign-ins for which Authentik did not run a second factor (`amr` claim of its id_token).
# Keep true in production. The local Authentik has no MFA stage by default, hence false here.
AUTHENTIK_REQUIRE_MFA=false

# --- Google ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft (Entra ID) -------------------------------------------------------
# App registration in Azure. "organizations" accepts work accounts of any company, never personal accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations

# --- Security ----------------------------------------------------------------
# Better Auth rate limiting (keep true outside tests).
RATE_LIMIT_ENABLED=true
# Header carrying the client IP, set by your reverse proxy (e.g. x-real-ip).
TRUSTED_IP_HEADER=x-forwarded-for

# --- Database migrations -------------------------------------------------------
# Apply pending migrations when the server starts (handy for single-instance deployments).
MIGRATE_ON_START=false
# Location of the SQL migrations (the Docker image ships them in /app/migrations).
MIGRATIONS_DIR=server/lib/db/migrations

# --- Local testing tools -------------------------------------------------------
# Client secrets printed by `pnpm seed:clients` (used by `pnpm oauth:token` only).
DATAHUB_CLIENT_SECRET=
APP_CLIENT_SECRET=
